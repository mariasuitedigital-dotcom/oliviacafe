# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# === SUPABASE (Frontend público: solo URL + ANON KEY) ===
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="TU_SUPABASE_ANON_KEY"
VITE_DEFAULT_NEGOCIO_SLUG="olivia"
# Solo clave pública VAPID para PushManager.subscribe() en el navegador:
VITE_VAPID_PUBLIC_KEY="TU_VAPID_PUBLIC_KEY"
# Clave de consola Root (desarrollador) para aprovisionar dueños con clave de 8 dígitos:
VITE_ROOT_DEV_KEY="1982"

# === SUPABASE (Solo Servidor / Vercel Serverless / Edge Functions) ===
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="TU_SUPABASE_SERVICE_ROLE_KEY"

# === WEB PUSH VAPID (Generar con: npx web-push generate-vapid-keys) ===
# NUNCA escribas VAPID_PRIVATE_KEY en código ni con prefijo VITE_
VAPID_PUBLIC_KEY="TU_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="TU_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:soporte@oliviacafe.pe"

# === CRON & WEBHOOKS (Solo Servidor) ===
CRON_SECRET="GENERAR_UN_SECRETO_LARGO_ALEATORIO"
N8N_WEBHOOK_URL="https://tu-n8n.tudominio.com/webhook/olivia-outbox"
N8N_INBOUND_WEBHOOK_URL="https://tu-n8n.tudominio.com/webhook/olivia-whatsapp-inbound"
N8N_WEBHOOK_SECRET="SECRETO_COMPARTIDO_N8N"

# === EVOLUTION API (WhatsApp por negocio - Solo Servidor / n8n) ===
EVOLUTION_API_URL="https://tu-evolution.tudominio.com"
EVOLUTION_API_KEY="TU_EVOLUTION_GLOBAL_API_KEY"
EVOLUTION_WEBHOOK_SECRET="SECRETO_WEBHOOK_EVOLUTION"
